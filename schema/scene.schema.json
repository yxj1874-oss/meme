{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meme:scene:v2",
  "title": "meme scene contract v2 (P1 capability set)",
  "description": "Declarative scene for the meme runtime. v2 accepts exactly what P1 can execute: spheres and planes; materials with base_color, metallic, roughness, ior and two-sided emission (GGX microfacet + exact dielectric Fresnel, Schlick for metals, a delta lobe below roughness^2 = 1e-3); point lights; constant/split environment; pinhole camera; unconstrained XPBD bodies under gravity. Every float carries x-unit plus minimum/maximum. Cross-field rules live in x-semantic-checks and are enforced before any GPU work. v1 scenes are migrated on load (x-migrations).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "seed",
    "materials",
    "objects"
  ],
  "anyOf": [
    {
      "required": [
        "render"
      ]
    },
    {
      "required": [
        "physics"
      ]
    }
  ],
  "dependentRequired": {
    "render": [
      "camera",
      "environment"
    ]
  },
  "properties": {
    "v": {
      "const": 2,
      "description": "Schema version, bound to golden set p1. v1 scenes are accepted and migrated (migrate_v1_to_v2). Not patchable."
    },
    "seed": {
      "$ref": "#/$defs/Seed"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "camera": {
      "$ref": "#/$defs/Camera"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "render": {
      "$ref": "#/$defs/Render"
    },
    "physics": {
      "$ref": "#/$defs/Physics"
    },
    "materials": {
      "type": "object",
      "description": "Id-keyed map. Key order in the JSON text carries no meaning; the runtime iterates in byte order of the key.",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Material"
      },
      "minProperties": 0,
      "maxProperties": 256
    },
    "objects": {
      "type": "object",
      "description": "Id-keyed map of renderable and/or simulated objects. A sphere with `body` is dynamic; everything else is static.",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Object"
      },
      "minProperties": 0,
      "maxProperties": 4096
    },
    "lights": {
      "type": "object",
      "description": "Id-keyed map of lights that are not geometry. Emissive spheres are area lights automatically.",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Light"
      },
      "minProperties": 0,
      "maxProperties": 64
    }
  },
  "$defs": {
    "Seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Global seed. Every random source is rng(stream, counter) = Philox4x32-10(key=(seed, stream), counter). See x-rng-streams."
    },
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "Entity id. Lowercase ASCII so JSON Pointer paths need no escaping (/objects/ball_1/radius_m)."
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "description": "Free text, excluded from scene_hash. Never read by the runtime.",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[\\x20-\\x7e]*$"
        },
        "note": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "Coord_m": {
      "type": "number",
      "x-unit": "m",
      "minimum": -10000,
      "maximum": 10000
    },
    "Radius_m": {
      "type": "number",
      "x-unit": "m",
      "minimum": 0.001,
      "maximum": 1000
    },
    "DirComponent_1": {
      "type": "number",
      "x-unit": "1",
      "minimum": -1,
      "maximum": 1
    },
    "Unit01_1": {
      "type": "number",
      "x-unit": "1",
      "minimum": 0,
      "maximum": 1
    },
    "Luminance_cdm2": {
      "type": "number",
      "x-unit": "cd/m2",
      "minimum": 0,
      "maximum": 1000000000
    },
    "DisplayWhite_cdm2": {
      "type": "number",
      "x-unit": "cd/m2",
      "minimum": 1e-06,
      "maximum": 1000000000
    },
    "Mass_kg": {
      "type": "number",
      "x-unit": "kg",
      "minimum": 1e-06,
      "maximum": 1000000
    },
    "VelocityComponent_m_s": {
      "type": "number",
      "x-unit": "m/s",
      "minimum": -10000,
      "maximum": 10000
    },
    "GravityComponent_m_s2": {
      "type": "number",
      "x-unit": "m/s2",
      "minimum": -100,
      "maximum": 100
    },
    "Dt_s": {
      "type": "number",
      "x-unit": "s",
      "minimum": 1e-05,
      "maximum": 0.1
    },
    "Vfov_rad": {
      "type": "number",
      "x-unit": "rad",
      "minimum": 0.01,
      "maximum": 3.0
    },
    "Vec3_Coord_m": {
      "type": "array",
      "x-unit": "m",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Coord_m"
      }
    },
    "Vec3_Dir_1": {
      "type": "array",
      "x-unit": "1",
      "description": "Direction; normalized by the runtime in f64. Norm must be >= 1e-3 (E_ZERO_VECTOR).",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/DirComponent_1"
      }
    },
    "Color_1": {
      "type": "array",
      "x-unit": "1",
      "description": "Linear Rec.709 RGB, each channel in [0,1].",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Unit01_1"
      }
    },
    "Vec3_Velocity_m_s": {
      "type": "array",
      "x-unit": "m/s",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/VelocityComponent_m_s"
      }
    },
    "Vec3_Gravity_m_s2": {
      "type": "array",
      "x-unit": "m/s2",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/GravityComponent_m_s2"
      }
    },
    "Camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "position_m",
        "look_at_m",
        "up",
        "vfov_rad"
      ],
      "properties": {
        "model": {
          "const": "pinhole"
        },
        "position_m": {
          "$ref": "#/$defs/Vec3_Coord_m"
        },
        "look_at_m": {
          "$ref": "#/$defs/Vec3_Coord_m"
        },
        "up": {
          "$ref": "#/$defs/Vec3_Dir_1"
        },
        "vfov_rad": {
          "$ref": "#/$defs/Vfov_rad"
        }
      }
    },
    "Environment": {
      "description": "Infinitely distant emitter seen by rays that hit nothing. Radiance RGB = luminance_cdm2 * color / Y(color), Y = BT.709 luma weights.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "luminance_cdm2",
            "color"
          ],
          "properties": {
            "type": {
              "const": "constant"
            },
            "luminance_cdm2": {
              "$ref": "#/$defs/Luminance_cdm2"
            },
            "color": {
              "$ref": "#/$defs/Color_1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "up",
            "upper_cdm2",
            "lower_cdm2",
            "color"
          ],
          "description": "Directions d with dot(d, up) > 0 see upper_cdm2, the rest see lower_cdm2. Gives analytic irradiance (1+cos(theta))/2 on tilted planes.",
          "properties": {
            "type": {
              "const": "split"
            },
            "up": {
              "$ref": "#/$defs/Vec3_Dir_1"
            },
            "upper_cdm2": {
              "$ref": "#/$defs/Luminance_cdm2"
            },
            "lower_cdm2": {
              "$ref": "#/$defs/Luminance_cdm2"
            },
            "color": {
              "$ref": "#/$defs/Color_1"
            }
          }
        }
      ]
    },
    "Render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "spp",
        "max_bounces",
        "sampler",
        "integrator",
        "display_white_cdm2"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "spp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "description": "Fixed samples per pixel. Sample s of pixel p always uses counter (px, py, s, dim); pass/tile splitting must not change output bytes."
        },
        "max_bounces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256,
          "description": "Number of scattering events. Emission is collected at surface interactions 1..max_bounces+1 (by hitting emitters, or for nee/mis by light sampling at interactions 1..max_bounces); the environment is collected by any escaping ray or by light sampling. No Russian roulette."
        },
        "sampler": {
          "enum": [
            "independent"
          ]
        },
        "integrator": {
          "enum": [
            "pt_p1"
          ]
        },
        "display_white_cdm2": {
          "$ref": "#/$defs/DisplayWhite_cdm2",
          "description": "Linear radiance mapped to display 1.0 before clamp + sRGB OETF in the PNG. Does not affect the linear PFM."
        },
        "strategy": {
          "enum": [
            "bsdf",
            "nee",
            "mis"
          ],
          "default": "mis",
          "description": "Estimator: bsdf = BSDF sampling only; nee = light sampling for every samplable light (BSDF hits on them count 0); mis = both, weighted by the power heuristic. All three are unbiased."
        }
      }
    },
    "Physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrator",
        "gravity_m_s2",
        "dt_s",
        "steps",
        "record_every_steps"
      ],
      "properties": {
        "integrator": {
          "enum": [
            "xpbd_unconstrained_p0"
          ],
          "description": "XPBD loop of Macklin et al. 2016 Alg.1 with zero constraints, delta form: dx = dt*v + dt^2*g; x += dx; v = dx * (1/dt)."
        },
        "gravity_m_s2": {
          "$ref": "#/$defs/Vec3_Gravity_m_s2"
        },
        "dt_s": {
          "$ref": "#/$defs/Dt_s"
        },
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "record_every_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "State snapshot at step 0, every k steps, and at the final step."
        }
      }
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_color"
      ],
      "description": "metallic blends a GGX conductor (F0 = base_color, Schlick) with a dielectric: a GGX coat with exact Fresnel at ior over a Lambert base coupled for energy conservation. alpha = roughness^2 (Burley 2012); alpha < 1e-3 is a delta lobe. Defaults reproduce the v1 Lambert material exactly. Emission is two-sided Lambertian.",
      "properties": {
        "base_color": {
          "$ref": "#/$defs/Color_1"
        },
        "emissive_cdm2": {
          "$ref": "#/$defs/Luminance_cdm2",
          "default": 0
        },
        "emissive_color": {
          "$ref": "#/$defs/Color_1",
          "default": [
            1,
            1,
            1
          ]
        },
        "metallic": {
          "$ref": "#/$defs/Unit01_1",
          "default": 0
        },
        "roughness": {
          "$ref": "#/$defs/Unit01_1",
          "default": 1
        },
        "ior": {
          "$ref": "#/$defs/Ior_1",
          "default": 1
        }
      }
    },
    "Body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass_kg",
        "velocity_m_s"
      ],
      "description": "Makes a sphere dynamic. center_m is the position at step 0.",
      "properties": {
        "mass_kg": {
          "$ref": "#/$defs/Mass_kg"
        },
        "velocity_m_s": {
          "$ref": "#/$defs/Vec3_Velocity_m_s"
        }
      }
    },
    "Object": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "center_m",
            "radius_m",
            "material"
          ],
          "properties": {
            "shape": {
              "const": "sphere"
            },
            "center_m": {
              "$ref": "#/$defs/Vec3_Coord_m"
            },
            "radius_m": {
              "$ref": "#/$defs/Radius_m"
            },
            "material": {
              "$ref": "#/$defs/Id"
            },
            "body": {
              "$ref": "#/$defs/Body"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "point_m",
            "normal",
            "material"
          ],
          "description": "Infinite static plane through point_m. Rays with |dot(dir, normal)| < 2^-20 are treated as parallel (miss).",
          "properties": {
            "shape": {
              "const": "plane"
            },
            "point_m": {
              "$ref": "#/$defs/Vec3_Coord_m"
            },
            "normal": {
              "$ref": "#/$defs/Vec3_Dir_1"
            },
            "material": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      ]
    },
    "JsonPointer": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(/([^/~]|~[01])*)*$"
    },
    "PatchEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "base_scene_hash",
        "ops"
      ],
      "description": "The only interaction unit. Applied atomically to the scene whose hash is base_scene_hash, then the whole result is re-validated (schema + semantic). Any failure leaves the scene unchanged.",
      "properties": {
        "v": {
          "const": 1
        },
        "base_scene_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/PatchOp"
          }
        }
      }
    },
    "PatchOp": {
      "description": "RFC 6902 operation. `value` is checked after application by validating the resulting scene.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "add"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "replace"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "from",
            "path"
          ],
          "properties": {
            "op": {
              "const": "move"
            },
            "from": {
              "$ref": "#/$defs/JsonPointer"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "from",
            "path"
          ],
          "properties": {
            "op": {
              "const": "copy"
            },
            "from": {
              "$ref": "#/$defs/JsonPointer"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "test"
            },
            "path": {
              "$ref": "#/$defs/JsonPointer"
            },
            "value": true
          }
        }
      ]
    },
    "Ior_1": {
      "type": "number",
      "x-unit": "1",
      "minimum": 1,
      "maximum": 3,
      "description": "Index of refraction of the dielectric coat; 1 means no specular interface (pure Lambert when metallic = 0)."
    },
    "Intensity_cd": {
      "type": "number",
      "x-unit": "cd",
      "minimum": 0,
      "maximum": 1000000000
    },
    "Light": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "position_m",
            "intensity_cd",
            "color"
          ],
          "description": "Point light radiating intensity_cd in every direction; RGB intensity = intensity_cd * color / Y(color).",
          "properties": {
            "type": {
              "const": "point"
            },
            "position_m": {
              "$ref": "#/$defs/Vec3_Coord_m"
            },
            "intensity_cd": {
              "$ref": "#/$defs/Intensity_cd"
            },
            "color": {
              "$ref": "#/$defs/Color_1"
            }
          }
        }
      ]
    }
  },
  "x-unit-vocabulary": {
    "source": "UCUM case-sensitive codes (https://ucum.org/ucum)",
    "units": {
      "1": "dimensionless (albedo, color channel, direction component)",
      "m": "metre",
      "m/s": "metre per second",
      "m/s2": "metre per second squared",
      "kg": "kilogram",
      "s": "second",
      "rad": "radian",
      "cd/m2": "candela per square metre (luminance)",
      "cd": "candela (luminous intensity of point lights)"
    },
    "reserved": {
      "m2": "area",
      "kg/m3": "density (P2)",
      "m/N": "XPBD compliance alpha (P2)"
    }
  },
  "x-rng-streams": {
    "algorithm": "Philox4x32-10, Salmon et al. 2011 'Parallel Random Numbers: As Easy as 1, 2, 3' (SC11); KAT vectors from Random123 kat_vectors",
    "key": "(seed, stream)",
    "to_unit_float": "f32(u >> 8) * 2^-24, exact in [0, 1)",
    "id_word": "idhash32(id) = FNV-1a 32 of the UTF-8 id; distinct within its map or E_ID_HASH_COLLISION",
    "streams": {
      "0": {
        "name": "sampling",
        "counter": "(px, py, sample_index, dim_block)",
        "dim_block": "0 = pixel jitter (u0,u1); 1+b = bounce b BSDF sample: (u0,u1) direction, u2 lobe choice, u3 reserved; 0x80000000+b = bounce b light sample: u0 light choice, (u1,u2) point or direction on the light, u3 reserved"
      },
      "1": {
        "name": "procedural_noise",
        "status": "reserved P4"
      },
      "2": {
        "name": "fluid_perturbation",
        "status": "reserved P4"
      },
      "3": {
        "name": "physics_perturbation",
        "counter": "(idhash32(id), step, component, 0)",
        "status": "reserved P2"
      },
      "4": {
        "name": "harness_fuzz",
        "counter": "(case, field, trial, 0)",
        "owner": "oracle tooling only, never the runtime"
      },
      "5": {
        "name": "harness_schedule",
        "counter": "(run, tile, 0, 0)",
        "owner": "oracle tooling only: tile/dispatch order permutation"
      },
      "6": {
        "name": "substrate_probe",
        "counter": "(index, operand, 0, 0)",
        "owner": "FBH float-behaviour probe inputs; key seed is fixed, independent of any scene"
      }
    },
    "rules": [
      "Stream ids are never reused or renumbered.",
      "Scene work may only use streams 0-3; 4-5 belong to the test harness; 6 only feeds the substrate probe."
    ]
  },
  "x-canonical": {
    "steps": [
      "strict parse: reject duplicate keys (E_DUPLICATE_KEY) and non-finite numbers (E_NONFINITE)",
      "validate against this schema, then x-semantic-checks",
      "expand defaults",
      "drop /meta",
      "serialize with RFC 8785 JSON Canonicalization Scheme"
    ],
    "scene_hash": "\"sha256:\" + hex(SHA-256(canonical bytes))"
  },
  "x-semantic-checks": [
    {
      "code": "E_REF_MISSING",
      "rule": "every objects.*.material is a key of materials"
    },
    {
      "code": "E_RENDER_REQUIRES",
      "rule": "render present => camera and environment present"
    },
    {
      "code": "E_EMPTY_RUN",
      "rule": "render or physics present"
    },
    {
      "code": "E_CAMERA_DEGENERATE",
      "rule": "|look_at_m - position_m| >= 1e-3 * max(1, |position_m|) and |normalize(up) x normalize(look_at_m - position_m)| >= 1e-3"
    },
    {
      "code": "E_ZERO_VECTOR",
      "rule": "|v| >= 1e-3 for camera.up, plane normal, environment.up"
    },
    {
      "code": "E_PRECISION",
      "rule": "sphere radius_m >= 2^-12 * (|center_m| + radius_m), leaving >= 12 bits of f32 mantissa for hit-point precision"
    },
    {
      "code": "E_COLOR_LUMINANCE",
      "rule": "luminance or intensity > 0 => Y(color) >= 1e-3 with Y = 0.2126 R + 0.7152 G + 0.0722 B (ITU-R BT.709); applies to the environment, emissive materials and lights"
    },
    {
      "code": "E_PRECISION_DT",
      "rule": "if |g| > 0, for every dynamic body: |g| * dt_s >= 2^-16 * V with V = |velocity_m_s| + |g| * dt_s * steps (exact speed bound for unconstrained motion). Guarantees each step's velocity increment is >= 128 ulp(V), so gravity cannot be rounded away in f32."
    },
    {
      "code": "E_BUDGET",
      "rule": "width_px * height_px * spp * (max_bounces + 1) * max(1, |objects|) * (strategy == bsdf ? 1 : 2) <= 2^36 and |bodies| * steps <= 2^32"
    },
    {
      "code": "E_ID_HASH_COLLISION",
      "rule": "idhash32 distinct among object ids, among material ids and among light ids"
    },
    {
      "code": "E_LIGHT_INSIDE",
      "rule": "no point light lies inside or on a sphere: |position_m - center_m| > radius_m"
