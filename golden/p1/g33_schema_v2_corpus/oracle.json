{
  "id": "g33_schema_v2_corpus",
  "title": "Schema v2: 15 invalid scenes rejected with exact code and path",
  "covers": [
    "contract.schema"
  ],
  "kills": [
    "light-inside-check",
    "v2-error-mapping"
  ],
  "runs": [],
  "asserts": [
    {
      "id": "A1",
      "kind": "reject_corpus",
      "cases": [
        {
          "file": "invalid/metallic_over_one.json",
          "expect": [
            {
              "code": "E_RANGE",
              "path": "/materials/m/metallic"
            }
          ]
        },
        {
          "file": "invalid/roughness_negative.json",
          "expect": [
            {
              "code": "E_RANGE",
              "path": "/materials/m/roughness"
            }
          ]
        },
        {
          "file": "invalid/ior_below_one.json",
          "expect": [
            {
              "code": "E_RANGE",
              "path": "/materials/m/ior"
            }
          ]
        },
        {
          "file": "invalid/ior_over_three.json",
          "expect": [
            {
              "code": "E_RANGE",
              "path": "/materials/m/ior"
            }
          ]
        },
        {
          "file": "invalid/intensity_negative.json",
          "expect": [
            {
              "code": "E_RANGE",
              "path": "/lights/l/intensity_cd"
            }
          ]
        },
        {
          "file": "invalid/light_type_spot.json",
          "expect": [
            {
              "code": "E_VARIANT",
