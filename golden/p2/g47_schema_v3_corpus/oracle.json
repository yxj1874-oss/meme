{
  "id": "g47_schema_v3_corpus",
  "title": "Schema v3: 20 invalid scenes rejected with exact code and path",
  "covers": [
    "contract.schema"
  ],
  "kills": [
    "joint-ref-check",
    "mass-ratio-check",
    "overlap-check",
    "v3-error-mapping"
